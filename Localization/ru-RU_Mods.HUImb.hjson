Items: {
	NIQ: {
		DisplayName: NIQ
		Tooltip: Первый предмет в этом моде
	}

	KombatMadnessPotion: {
		DisplayName: Водка
		Tooltip:
			'''
			При использовании дает эффект боевого безумия
			Увеличивается наносимый урон ближнего боя на 15%
			«фанта + водка «5 Озёр» = Фантазёр»
			'''
	}

	UltimateInfinityPotion: {
		DisplayName: Бесконечное универсальное зелье
		Tooltip:
			'''
			Нажатие ПКМ сменяет класс баффа
			При использовании дает баффы в зависимости от класса
			«Испытайте новые ощущения!»
			'''
