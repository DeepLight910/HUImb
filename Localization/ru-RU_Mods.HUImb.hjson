		TownNPCMood: {
			Content: Я не требователен.
			NoHome: Лучше тебе найти мне дом.
			FarFromHome: Ты же знаешь, лучше вернуть меня домой быстрее.
			LoveSpace: Я люблю космос, а также личное пространство.
			DislikeCrowded: Слишком шумно, мешают.
			HateCrowded: Я немногого прошу, лишь свой отдельный дом.
			LoveBiome: Я люблю Освящение, Доставь меня туда.
			LikeBiome: Мне нравится {BiomeName}, там тихо и спокойно.
			DislikeBiome: Не люблю я смертельную опасность багрянца и искажения.
			HateBiome:
				'''
				Я ненавижу пещеры по двум причинам:
				1)Я не негр
				2)Там нету звёзд
				'''
			LoveNPC: Маг, довольно хороший собеседник.
			LikeNPC: Мне нравится {NPCName}.
			DislikeNPC: Мне не нравится эта девчонка, в розовых одеждах, она слишком громкая.
			HateNPC: Ненавижу технологии, а киборга тем более.
			LikeNPC_Princess: Во времена моей молодости, за таких, как {NPCName}, государства отдавали.
			Princess_LovesNPC: Мне нравится {NPCName}.
		}

		Bestiary:
			'''
			Страный астроном,
			Любит звезды, но ненавидит созвездия.
			'''

		Buttons: {
			QuestButton: Задание
			Button2: Космос
		}

		Dialogue: {
			dialogd: Зодиак, как же ты глуп.
			dialog0: Я уверен, что старше всех здешних.
			dialog1: Отстань.
			dialog2: Когда-нибудь я найду способ возродить Его.
			dialog3: Ты ко мне по делу?
			dialog4: ... звезды...
			dialog5: Скажи, ты же пользуешся наследием планет?
			dialog6: Как думаешь, сложно возродить метафизическое существо?
			dialog7:
				'''
				Может, ты станешь ключом.
				Впрочем, это лишь догадки.
				'''
			dialog8: Есть одна мысль...
		}

		Space: {
			Space0:
				'''
				Вначале всего был Зодиак.
				Он, создал всё.
				'''
			Space1:
				'''
				Первым, что создал Зодиак,
				Были его знаки.
				После - Вселеная.
				'''
			Space2:
				'''
				Во всленной были созданы созвездия,
				В них звезды,
				А вокруг последних планеты.
				'''
			Space3:
				'''
				В большенстве древних мифов
				Планеты и звезды - семья.
				'''
			Space4:
				'''
				Например в нашей системе:
				Солнце - второй по возрасту,
				Изображается защитником и справедливым судьей
				Меркурий - самый младший по возрасту,
				Неумелый ремесленик.
				Венера - старшая сестра,
				Также ее имя носит Богиня Любви.
				'''
			Space5:
				'''
				Земля - младшая сестра,
				Из мифов, ее характер мягкий и добрый.
				Марс - пятый по возросту,
				Часто изображается дерзким и несдержанным.
				Юпитер - Самый старший среди детей Зодиака,
				Задумчивый и отстранённый.
				'''
			Space6:
				'''
				Сатурн - третий по возрасту,
				Самый одаренный из детей.
				Уран - восьмой по возросту,
				Про него мало, что говорится в мифах.
				Нептун - самый младший,
				В мифах - младенец,
				Поэтому у него небыло ни наследия, ни характера.
				'''
		}
	}

