NPCs: {
	Shailushai: {
		DisplayName: Шайлушай
		Census.SpawnCondition: Светящийся гриб должен находиться в инвентаре.

		Names: {
			Name0: kяrv
			Name1: Hanabirin
			Name2: Van
			Name3: Sus M.
			Name4: Billie
			Name5: Enevrok
			Name6: Олег Тинькофф
			Name7: Этери
			Name8: Nikita П@cтерн@к
			Name9: Гай Юлий Цезарь
			Name10: Диск
			Name11: Френсис
			Name12: Этель
			Name13: Рудольф
			Name14: Рудеус
			Name15: Хантер
			Name16: Дружок Б.
			Name17: Павел Чекурда
			Name18: Папа Смурф
			Name19: Гелла
		}

		TownNPCMood: {
			Content: Я доволен.
			NoHome: Где мне жить?
			FarFromHome: Верни меня домой.
			LoveSpace: Знаешь, я люблю, когда много места.
			DislikeCrowded: Тут много людей которые не веселятся.
			HateCrowded: СЛИШКОМ МНОГО ЗОЖНИКОВ ВОКРУГ МЕНЯ.
			LoveBiome: Бля абажаю {BiomeName}, там так много грибов.
			LikeBiome: Слушай, мне нравится {BiomeName}, там можно пособирать «Материалы».
			DislikeBiome: не люблю я {BiomeName}, там слишком пустынно
			HateBiome: Я ненавижу {BiomeName}, Там сыро и грязно, но там можно найти грибочки.
			LoveNPC: Мне по душе {NPCName}.
			LikeNPC: Мне нравится {NPCName}.
			DislikeNPC: Мне не нравится {NPCName}.
			HateNPC: Не терплю таких, как {NPCName}.
			LikeNPC_Princess: Мне нравится {NPCName}.
			Princess_LovesNPC: Мне нравится {NPCName}.
		}

		Bestiary:
			'''
			Наверное грибоедов - это лучшая фамилия применимая к этому персонажу.
			И нет не потому что он отлично пишет, а потому что он нарик
			Не понятно почему, но трюфель его обожает. 
			'''

		Buttons: {
			QuestButton: Задание
			Button2: Анекдот
		}

		QuestFrases: {
			ChatFrase: Я ждал этого момента 4, нет 5 тысяч лет!
			MenuFrase: Я знал, что ты будешь тем кто мне вернет веру в жизнь
			ChatFrase2: Взамен того что ты мне дал я дам тебе этот бонг.
			ChatFrase3: Его передавали из поколения в поколение
		}

		Dialogue: {
			dialogd:
				'''
				ВНИМАНИЕ!
				ЕСЛИ ВЫ ВИДИТЕ ЭТОТ ТЕКСТ НЕМЕДЛЕНО ЗАКРОЙТЕ ИГРУ
				И ПЕРЕЗАГРУЗИТЕ КОМПЬЮТЕР
				'''
			dialog0: Ты знал что у трюфеля есть дети?
			dialog1: Внимание анекдот...
			dialog2:
				'''
				Говорят, что существует утеряный рецепт мефа.
				Я бы хотел попробовать.
				'''
			dialog3: Привет, человек, хошь грибы?
			dialog4: Ебануться тапки гнутся.
			dialog5:
				'''
				Физика лучший предмет на свете!
				-Van
				'''
			dialog6: Саша Р. - негр.
			dialog7:
				'''
				Знаешь странствующеего торговца?
				Иногда у него есть в ассортименте картина «Скорбящая»
				Так вот, это мой любимый персонаж.
				'''
			dialog8:
				'''
				D4C!
				Способность перемещенния между мирами подвластно одному лишь мне...
				Dirty Deeds Done Dirty Cheap!
				-Sus M. & DeepLight
				'''
		}

		Anekdots: {
			Anekdot0:
				'''
				Пришла к деду, который славился на все село своей мудростью, молодая женщина и спрашивает:
				- А что это, скажите, означает, если ко мне ласточка в дом залетела?
				- Чего ж не сказать? Скажу! Это у тебя или дверь, или окно были открыты.
				'''
			Anekdot1:
				'''
				На открытии новой дороги в Батуми начальник перерезает ленточку и толкает речь:
				— Старый дорог совсем плохой был: колдоёбин на колдоёбине.
				А его дергают за рукав и поправляют:
				— Не колдоёбин, а выбоин. Было много выбоин...
				А он продолжает:
				— Вот мне слюшай подсказывают: даже выебан был кто-то на той дорога!
				'''
			Anekdot2:
				'''
				Вовочка на уроке зоологии:
				— Я вчера нашел четыре дохлые мухи. Два самца и две самки.
				Учитель смотрит скептически на ученика:
				— А как ты смог определить их пол?
				— Очень просто! Две приклеились к пиву, а две к зеркалу!
				'''
			Anekdot3:
				'''
				Два американца — белый и черный — приехали в Россию. Белый говорит: 
				— Давай как русские нажремся водки на стройке!
				— Давай!
				Нажрались водки, негр отключился. Белый взял его на плечо и понес. Выходит сторож, орет:
				— Стоять!
				Белый говорит:
				— Хелло!
				— Сам хуйло! Рубероид положи на место!
				'''
			Anekdot4:
				'''
				Мужик с женой возвращается из гостей и причитает: 
				-Как же люди богато живут! У них даже унитаз золотой.
				Потом решил позвонить поблагодарить за вечер.
				трубку берёт мальчик, сын хозяина квартиры. 
				мужик просит позвать отца и слышит в трубке голос мальчика:
				-Папа, папа, это звонит тот дядя, который тебе в тромбон насрал.
				'''
			Anekdot5:
				'''
				Мужик показывает квартиру своему другу. Вдруг тот видит на стене большой медный таз.  
				— А это что еще такое?
				— Говорящие часы!
				— ???
				Мужик со всей силой бьет по тазу.
				Из-за стены раздается голос:
				— Два часа ночи, еб твою мать!!!
				'''
			Anekdot6:
				'''
				Едут в автобусе на рыбалку дед, отец, и внук. Заходит в автобус деваха в колготках в сеточку. Внук думает:
				— Вот, телка, зашибись...
				Отец думает:
				— Поди с отца все деньги на шмотки вытянула...
				Дед:
				— Блин, сети забыли...
				'''
			Anekdot7:
				'''
				Как называется секс двух карликов?



				Короткое замыкание!
				'''
			Anekdot8:
				'''
				Девушка по имени Полина любит только груповой
				секс?


				Потому что один в поле не воин.
				'''
			Anekdot9:
				'''
				В нашей семье все любят хлеб:
				Мама серый, бабушка батон, а батя черный, 
				Что спиздил, то и ест.
				'''
			Anekdot10:
				'''
				Какие стоны издает гей послуе секса?




				Не знаю, хотел у тебя спросить.
				'''
			Anekdot11:
				'''
				Лежит мужик после секса с проституткой, та говорит:
				-Мужик, а можно твои яйца подержать?
				-Конечно, можно.
				Держит она так 5 минут... 10... 15 Мужик:
				-Да чем тебе так нравятся мои яйца?
				-Да ничем, братан. По своим скучаю.
				'''
			Anekdot12:
				'''
				Девушка заходит в ceкс-шоп и спрашивает:
				— У Вас есть презеки с вкусом малины?
				— Есть!
				— А со вкусом банана?
				— Есть!
				— А со вкусом черной смородины есть?
				Продавец:
				— Девушка, вам хуй сосать или компот варить?!
				'''
			Anekdot13:
				'''
				Лекция началась. Один студент опоздал. Лектор:
				—Почему вы опоздали?
				—Я участвовал в соревнованиях по ралли...
				Через некоторое время заходит ещё один студент. Профессор спрашивает:
				—Вы тоже с ралли?
				Студент удивленно:
				—Нет, курил.
				'''
		}
	}

