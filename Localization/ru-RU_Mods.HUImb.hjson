		Tl1: Текущий класс:[c/50fa7b: Стрелок]
		Tl2: Текущий класс:[c/bd93f9: Маг]
		Tl3: Текущий класс:[c/f1fa8c: Призыватель]
		Tl4: Текущий класс:[c/6e6e6e: Рыбак]
		Tl5: Текущий класс:[c/692e02: Строитель]
		Tl6: Текущий класс:[c/57c785: Шахтер]
		Tl7: Текущий класс:[c/b335b5: Зрение Биомов]
		Tl8: Текущий класс:[c/9ee8f0: Очищение]
	}

	MoonWand: {
		DisplayName: Лунный посох
		Tooltip:
			'''
			Стреляет лунными лучами
			Накладывает ихор и теневой огонь при попадании
			«Слезы лунного лорда стали основой этого посоха.
			Будь с ним аккуратнее»
			'''
	}

	GraveThrower: {
		DisplayName: Могиломёт
		Tooltip:
			'''
			Стреляет надгробными камнями
			Надгробные камни имеют разные эффекты и урон
			Прошивает очень большое кол-во целей
			«Непонятно откуда берутся надгробные камни,
			Но древние мастера говорили,
			Что оружие берёт их откуда-то с кладбищ,
			Так что если вы пришли на кладбище, а камня на могиле вашего деда нету,
			То Будьте уверены с шансом 13,76568% он полетел в какого-то врага»
			'''
	}

	QuestItemMef: {
		DisplayName: «Затерянный» Мет
		Tooltip:
			'''
			Затерянный рецепт мета, который вы откуда-то знаете.
			Некоторые люди (ну или не очень люди) отдадут вам всё свое богатство за этот мет.
			«Впервые упоминание этого мета были обнаружены до постройки Азафура»
			'''
	}

	SwordShroomBonk: {
		DisplayName: Великий грибной бонг
		Tooltip:
			'''
			Стреляет несколькими самонаводящимися светящимися грибами
